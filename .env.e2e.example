# Environment for the Playwright e2e suite. Copy to `.env.e2e` (gitignored) and
# adjust if your local Postgres differs. These point at a DEDICATED test
# database (`saldo_test`) on the docker-compose Postgres so dev data is never
# touched. playwright.config.ts loads this file and passes it to the app server.

# Dedicated e2e database (create it once, then run migrations against it — see e2e/README.md)
POSTGRES_PRISMA_URL=postgres://postgres:password@localhost:3006/saldo_test
POSTGRES_URL_NON_POOLING=postgres://postgres:password@localhost:3006/saldo_test

# NextAuth needs a secret (JWT sessions) and the canonical URL.
NEXTAUTH_SECRET=e2e-test-secret-not-for-production
# The e2e app runs on a dedicated port (3100) to avoid colliding with a dev
# server on 3000. playwright.config.ts sets NEXTAUTH_URL/PORT to match.
NEXTAUTH_URL=http://localhost:3100

# OAuth providers are not exercised by the e2e suite (it signs in with the
# Credentials provider), but the config reads these at startup — dummy values
# keep them defined.
GOOGLE_CLIENT_ID=e2e
GOOGLE_CLIENT_SECRET=e2e
GITHUB_CLIENT_ID=e2e
GITHUB_CLIENT_SECRET=e2e
