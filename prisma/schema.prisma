generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int                     @id @default(autoincrement())
  email                  String                  @unique
  name                   String?
  worklogs               Worklog[]
  settings               Settings?
  passwordResetData      PasswordResetData?
  expectedHoursOverrides ExpectedHoursOverride[]
  password               String?
  started_at             DateTime?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
}

model PasswordResetData {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Worklog {
  id                   Int      @id @default(autoincrement())
  user_id              Int
  user                 User     @relation(fields: [user_id], references: [id])
  from                 DateTime
  to                   DateTime
  comment              String?
  subtract_lunch_break Boolean  @default(false)
  absence              Absence?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

enum Absence {
  holiday
  flex_hours
  sick_leave
  other
}

model Settings {
  id                       Int      @id @default(autoincrement())
  user_id                  Int      @unique
  user                     User     @relation(fields: [user_id], references: [id])
  begin_date               DateTime
  initial_balance_hours    Int
  initial_balance_mins     Int
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
  from_default             String   @default("08:00")
  to_default               String   @default("16:00")
  expected_minutes_per_day Int      @default(450)
}

model ExpectedHoursOverride {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  date       DateTime
  minutes    Int
  label      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, date])
}
